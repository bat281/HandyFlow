# Supabase project (Settings > API). The publishable/anon key is safe for the browser;
# RLS protects the data. Never put the service-role/secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Public URL of the app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2: AI voice reports (server-only secrets: never prefix with NEXT_PUBLIC_) ---
# Mistral does both steps (Voxtral speech-to-text + report drafting). Works on Mistral's free plan.
MISTRAL_API_KEY=
# Optional: set to draft reports with Claude instead (paid). Used automatically when present.
# ANTHROPIC_API_KEY=
# Optional: OpenAI speech-to-text instead of Voxtral
# OPENAI_API_KEY=
# Optional overrides
# TRANSCRIPTION_PROVIDER=mistral   # or openai
# AI_REPORT_PROVIDER=mistral       # or anthropic
# AI_REPORT_MODEL=                 # Mistral: comma-separated models tried in order; Claude: one model id
# AI_MONTHLY_LIMIT=200             # AI reports per company per month
