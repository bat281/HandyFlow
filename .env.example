# Supabase project (Settings > API). The publishable/anon key is safe for the browser;
# RLS protects the data. Never put the service-role/secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Public URL of the app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2: AI voice reports (server-only secrets: never prefix with NEXT_PUBLIC_) ---
# Claude writes the structured report from the transcript.
ANTHROPIC_API_KEY=
# Speech-to-text: Mistral Voxtral by default (EU). Set OPENAI_API_KEY instead to use OpenAI.
MISTRAL_API_KEY=
# OPENAI_API_KEY=
# Optional overrides
# TRANSCRIPTION_PROVIDER=mistral   # or openai
# AI_REPORT_MODEL=claude-opus-5-5
# AI_MONTHLY_LIMIT=200             # AI reports per company per month
